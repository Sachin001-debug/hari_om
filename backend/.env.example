# ==============================================================================
# HARI OM REAL ESTATE - BACKEND ENVIRONMENT VARIABLES
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=5000

# Frontend URL (Strict CORS allowlist & CSRF validation)
FRONTEND_URL=http://localhost:3000

# Local MySQL Database Settings (Port 3307 for local MySQL)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=hari_om_real_estate
DB_SSL=false

# Optional unified database connection string:
DATABASE_URL=mysql://root:@127.0.0.1:3307/hari_om_real_estate

# JWT Secrets (Minimum 32 characters each)
# Generate high-entropy keys using:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="replace_with_at_least_32_characters_random_hex_secret_access_key"
JWT_REFRESH_SECRET="replace_with_at_least_32_characters_random_hex_secret_refresh_key"

# Initial Super Admin Seed Credentials
# IMPORTANT: Change these values before seeding!
# Password must be at least 12 characters and contain:
# 1 uppercase letter, 1 lowercase letter, 1 number, and 1 special symbol.
# Note: Always enclose values in quotes if they contain special symbols like #.
ADMIN_NAME="Hari Om Administrator"
ADMIN_EMAIL="admin@hariomrealestate.com"
ADMIN_PASSWORD="ChangeMe#2026SecurePass!"

